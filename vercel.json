{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/panel", "destination": "/admin.html" },
    { "source": "/terminal", "destination": "/terminal.html" },
