{
  "version": 2,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__path=/api/:path*" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/panel", "destination": "/admin.html" },
    { "source": "/terminal", "destination": "/terminal.html" },
    { "source": "/webapp", "destination": "/index.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
